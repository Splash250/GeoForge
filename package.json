{
  "name": "maplibre-geoforge",
  "private": false,
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "A MapLibre GL JS toolkit for feature operations, rendering, geometry, and editing.",
  "license": "MIT",
  "module": "dist/maplibre-geoforge.es.js",
  "main": "dist/maplibre-geoforge.umd.js",
  "types": "dist/maplibre-geoforge.d.ts",
  "exports": {
    ".": {
      "types": "./dist/maplibre-geoforge.d.ts",
      "import": "./dist/maplibre-geoforge.es.js",
      "require": "./dist/maplibre-geoforge.umd.js"
    },
    "./dist/maplibre-geoforge.css": {
      "types": "./dist/maplibre-geoforge.css.d.ts",
      "default": "./dist/maplibre-geoforge.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PATCHES.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "docs",
    "!docs/production-readiness-*.md",
    "!docs/superpowers"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm run build:types",
    "build:budget": "node scripts/check-bundle-budget.mjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly && tsc-alias && rollup -c rollup.config.dts.js && node scripts/write-css-dts.mjs && rimraf dist/types",
    "ts": "tsc --noEmit",
    "ts-watch": "tsc --noEmit --watch",
    "ts:autofix": "ts-autofix",
    "lint": "eslint . --ext .ts,.tsx,.svelte",
    "lint:fix": "eslint . --ext .ts,.tsx,.svelte --fix",
    "formatter": "prettier src tests --check",
    "formatter:fix": "prettier src tests --write",
    "check": "pnpm run formatter && pnpm run lint && pnpm run ts && pnpm run test:unit",
    "testserver": "vite --port 4000 --mode test",
    "test": "pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:overlays": "vitest run tests/overlays/html",
    "test:e2e": "cross-env VITE_GEOFORGE_VERSION=free playwright test --grep-invert @serial-edit-interaction && cross-env VITE_GEOFORGE_VERSION=free playwright test --grep @serial-edit-interaction --workers=1",
    "test:headed": "cross-env VITE_GEOFORGE_VERSION=free playwright test --headed",
    "test:ui": "cross-env VITE_GEOFORGE_VERSION=free playwright test --ui",
    "test:debug": "cross-env VITE_GEOFORGE_VERSION=free playwright test --debug",
    "prepare": "shx test -f dist/maplibre-geoforge.es.js || pnpm run build"
  },
  "dependencies": {
    "@turf/area": "^7.3.1",
    "@turf/bbox": "^7.3.1",
    "@turf/bearing": "^7.3.1",
    "@turf/boolean-intersects": "^7.3.1",
    "@turf/boolean-point-in-polygon": "^7.3.1",
    "@turf/boolean-point-on-line": "^7.3.1",
    "@turf/boolean-valid": "^7.3.1",
    "@turf/buffer": "^7.3.1",
    "@turf/centroid": "^7.3.1",
    "@turf/circle": "^7.3.1",
    "@turf/clone": "^7.3.1",
    "@turf/combine": "^7.3.1",
    "@turf/destination": "^7.3.1",
    "@turf/difference": "^7.3.1",
    "@turf/distance": "^7.3.1",
    "@turf/flatten": "^7.3.1",
    "@turf/helpers": "^7.3.1",
    "@turf/invariant": "^7.3.1",
    "@turf/length": "^7.3.1",
    "@turf/line-intersect": "^7.3.1",
    "@turf/line-split": "^7.3.1",
    "@turf/line-to-polygon": "^7.3.1",
    "@turf/meta": "^7.3.1",
    "@turf/polygon-to-line": "^7.3.1",
    "@turf/rewind": "^7.3.1",
    "@turf/transform-rotate": "^7.3.1",
    "@turf/transform-scale": "^7.3.1",
    "@turf/union": "^7.3.1",
    "@turf/unkink-polygon": "^7.3.1",
    "dompurify": "^3.4.9",
    "lodash-es": "^4.17.21",
    "loglevel": "^1.9.2",
    "type-fest": "^5.3.1"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.14.0 <6.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.57.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/geojson": "^7946.0.16",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "maplibre-gl": "5.15.0",
    "playwright": "1.57.0",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.2",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "^6.3.0",
    "sass": "^1.96.0",
    "shx": "^0.4.0",
    "svelte": "^5.45.10",
    "svelte-eslint-parser": "^1.4.1",
    "svelte-preprocess": "^6.0.3",
    "ts-autofix": "^1.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^2.1.9",
    "vite-svg-loader": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
